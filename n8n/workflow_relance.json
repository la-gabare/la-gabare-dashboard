{
  "name": "Workflow 1b - Relance Lead sans reponse",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "hours", "hoursInterval": 6 }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Toutes les 6 heures",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "leads",
        "returnAll": true,
        "filterType": "manual",
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            { "keyName": "statut", "condition": "eq", "keyValue": "mail_envoye" },
            { "keyName": "mail_envoye_at", "condition": "lt", "keyValue": "={{ $now.minus({ days: 5 }).toISO() }}" }
          ]
        }
      },
      "id": "get-stale-leads",
      "name": "Leads sans reponse depuis 5j",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "supabaseApi": { "id": "yb1pkgTloAiaEunJ", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "a1", "name": "lead_id", "value": "={{ $json.id }}", "type": "string" },
            { "id": "a2", "name": "nom", "value": "={{ $json.nom }}", "type": "string" },
            { "id": "a3", "name": "email", "value": "={{ $json.email }}", "type": "string" },
            { "id": "a4", "name": "domaine", "value": "={{ $json.domaine }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "extract-fields",
      "name": "Extraire les champs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [680, 300]
    },
    {
      "parameters": {
        "fromEmail": "contact@la-gabare.fr",
        "toEmail": "={{ $json.email }}",
        "subject": "=Toujours interesse par {{ $json.domaine }} ?",
        "html": "=<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background-color:#EDE9E2;padding:40px 16px;\"><tr><td align=\"center\"><table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:600px;width:100%;background-color:#F5F2EC;border:1px solid rgba(26,19,16,0.1);\"><tr><td style=\"background-color:#1A1310;padding:32px 40px;text-align:center;\"><span style=\"font-family:Georgia,'Cormorant Garamond',serif;font-size:24px;letter-spacing:0.04em;color:#F5F2EC;\">La Gabare</span></td></tr><tr><td style=\"height:3px;background:linear-gradient(90deg,#5A1226,#B08D57);font-size:0;line-height:0;\">&nbsp;</td></tr><tr><td style=\"padding:44px 40px 24px 40px;\"><p style=\"margin:0 0 6px 0;font-family:Arial,'Geist',sans-serif;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#B08D57;\">Petite relance</p><h1 style=\"margin:0 0 20px 0;font-family:Georgia,'Cormorant Garamond',serif;font-weight:400;font-size:26px;line-height:1.25;color:#1A1310;\">Bonjour {{ $json.nom }},</h1><p style=\"margin:0 0 16px 0;font-family:Arial,'Geist',sans-serif;font-size:15px;line-height:1.7;color:#4A3E37;\">Nous n'avons pas eu de retour concernant votre demande pour <strong style=\"color:#1A1310;\">{{ $json.domaine }}</strong>. Est-ce toujours d'actualite ?</p><p style=\"margin:0 0 32px 0;font-family:Arial,'Geist',sans-serif;font-size:15px;line-height:1.7;color:#4A3E37;\">Si oui, choisissez l'option qui vous convient :</p></td></tr><tr><td style=\"padding:0 40px 20px 40px;\"><a href=\"https://cal.com/la-gabare/appel-decouverte-la-gabare\" style=\"display:inline-block;padding:12px 28px;background-color:#5A1226;color:#F5F2EC;font-family:Arial,'Geist',sans-serif;font-size:14px;font-weight:600;text-decoration:none;margin-bottom:12px;\">Reserver un appel &rarr;</a></td></tr><tr><td style=\"padding:0 40px 36px 40px;\"><a href=\"https://la-gabare.fr/formulaire-complet.html?lead_id={{ $json.lead_id }}\" style=\"display:inline-block;padding:12px 28px;background-color:transparent;border:1px solid #1A1310;color:#1A1310;font-family:Arial,'Geist',sans-serif;font-size:14px;font-weight:600;text-decoration:none;\">Completer le formulaire &rarr;</a></td></tr><tr><td style=\"background-color:#1A1310;padding:24px 40px;text-align:center;\"><p style=\"margin:0;font-family:Arial,'Geist',sans-serif;font-size:11px;letter-spacing:0.05em;color:rgba(245,242,236,0.5);\">La Gabare — Agence pour les domaines viticoles de la Loire</p></td></tr></table></td></tr></table>",
        "options": {}
      },
      "id": "send-smtp",
      "name": "Envoyer mail relance",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [900, 300],
      "credentials": {
        "smtp": { "id": "zLYsaXx2Fj28e6VW", "name": "SMTP La gabare" }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableId": "leads",
        "filterType": "manual",
        "filters": {
          "conditions": [
            { "keyName": "id", "condition": "eq", "keyValue": "={{ $('Extraire les champs').item.json.lead_id }}" }
          ]
        },
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "statut", "fieldValue": "relance" }
          ]
        }
      },
      "id": "update-status",
      "name": "MAJ statut = relance",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1120, 300],
      "credentials": {
        "supabaseApi": { "id": "yb1pkgTloAiaEunJ", "name": "Supabase account" }
      }
    }
  ],
  "connections": {
    "Toutes les 6 heures": { "main": [[{ "node": "Leads sans reponse depuis 5j", "type": "main", "index": 0 }]] },
    "Leads sans reponse depuis 5j": { "main": [[{ "node": "Extraire les champs", "type": "main", "index": 0 }]] },
    "Extraire les champs": { "main": [[{ "node": "Envoyer mail relance", "type": "main", "index": 0 }]] },
    "Envoyer mail relance": { "main": [[{ "node": "MAJ statut = relance", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
